generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DiscoveryKind {
  hot
  quality
}

enum RunStatus {
  queued
  running
  succeeded
  degraded
  failed
}

enum AiRunKind {
  topic
  trend
  creator
  digest
}

enum AiTask {
  topic_expansion
  trend_classification
  evidence_gap_detection
  candidate_assessment
  item_composition
  item_chinese_repair
  creator_localization
  interest_tagging
  digest_brief
}

enum AiUsageStatus {
  reserved
  succeeded
  failed
}

enum RunStageName {
  plan
  retrieve
  enrich
  assess
  followup
  compose
  quality_gate
  persist
}

enum RunStageStatus {
  running
  succeeded
  failed
}

enum DiscoveryTrigger {
  initial
  manual
  scheduled
}

enum KeywordProfileKind {
  entity
  domain
  unknown
}

enum SourceType {
  web
  feed
  social
  video
  community
  code
  paper
}

enum ProvenanceKind {
  ai_citation
  api_record
  feed_entry
  fetched_page
}

enum CreatorPlatform {
  rss
  x
  bilibili
  youtube
  bluesky
}

enum CreatorContentType {
  original
  repost
  reply
}

enum FeedbackValue {
  interested
  less
}

enum InterestEventType {
  topic_state
  creator_state
  feedback_state
}

enum InterestTagKind {
  topic
  entity
  content_type
}

enum InterestTagStatus {
  active
  retired
}

enum RecommendationSurface {
  feed
  digest
}

enum RecommendationLane {
  subscription
  interest
  trend
  exploration
}

enum DigestRunStatus {
  queued
  running
  succeeded
  skipped
  failed
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  timezone     String       @default("UTC")
  createdAt    DateTime     @default(now())
  sessions     Session[]
  topics       Topic[]
  trendMonitor TrendMonitor?
  trendRuns    TrendRun[]
  trendSeeds   TrendSeed[]
  radarItems   RadarItem[]
  creators     CreatorSubscription[]
  creatorRuns  CreatorRun[]
  creatorItems CreatorItem[]
  feedback     ContentFeedback[]
  interestEvents InterestEvent[]
  interestProfiles UserInterestProfile[]
  interestProfileVersions InterestProfileVersion[]
  recommendationDecisions RecommendationDecision[]
  feedImpressions FeedImpression[]
  interestMemorySettings InterestMemorySettings?
  forgottenInterestTags ForgottenInterestTag[]
  digestPreference DigestPreference?
  digestEmailVerifications DigestEmailVerification[]
  digestTestEmails DigestTestEmail[]
  digestRuns DigestRun[]
  aiRunBudgets AiRunBudget[]
  aiUsages AiUsage[]
  runStages RunStage[]
}

model RunStage {
  id            String         @id @default(uuid())
  runKind       AiRunKind
  runId         String
  userId        String
  stage         RunStageName
  status        RunStageStatus @default(running)
  attempt       Int            @default(1)
  inputDigest   String
  policyVersion String         @default("")
  routeVersion  String         @default("")
  startedAt     DateTime
  finishedAt    DateTime?
  errorCode     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  artifact      RunArtifact?

  @@unique([userId, runKind, runId, stage, inputDigest, policyVersion, routeVersion])
  @@index([userId, createdAt])
  @@index([runKind, runId, stage, status])
}

model RunArtifact {
  id         String   @id @default(uuid())
  stageId    String   @unique
  data       Json
  byteLength Int
  createdAt  DateTime @default(now())
  stage      RunStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model AiRunBudget {
  runKind              AiRunKind
  runId                String
  userId               String
  policyVersion        String
  budgetVersion        String
  maxCalls             Int
  maxInputTokens       Int
  maxOutputTokens      Int
  maxCostMicros        Int
  reservedCalls        Int      @default(0)
  reservedInputTokens  Int      @default(0)
  reservedOutputTokens Int      @default(0)
  reservedCostMicros   Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  usages               AiUsage[]

  @@id([runKind, runId])
  @@index([userId, createdAt])
}

model AiUsage {
  id                   String        @id @default(uuid())
  runKind              AiRunKind
  runId                String
  userId               String
  task                 AiTask
  status               AiUsageStatus @default(reserved)
  routeVersion         String
  requestedModel       String
  actualModel          String?
  provider             String?
  estimatedInputTokens Int
  reservedOutputTokens Int
  reservedCostMicros   Int
  inputTokens          Int?
  outputTokens         Int?
  reasoningTokens      Int?
  cachedTokens         Int?
  costMicros           Int?
  errorCode            String?
  startedAt            DateTime
  finishedAt           DateTime?
  createdAt            DateTime      @default(now())
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget               AiRunBudget   @relation(fields: [runKind, runId], references: [runKind, runId], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([runKind, runId, createdAt])
  @@index([status, createdAt])
}

model Session {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Topic {
  id                    String          @id @default(uuid())
  userId                String
  keyword               String
  normalizedKeyword     String
  expandedTerms         String[]        @default([])
  keywordProfile        KeywordProfileKind @default(unknown)
  createdAt             DateTime        @default(now())
  deletedAt             DateTime?
  pausedAt              DateTime?
  variantsInitialized   Boolean         @default(false)
  lastRunAt             DateTime?
  runStatus             RunStatus       @default(queued)
  queuedTrigger         DiscoveryTrigger?
  lastError             Json?
  nextRunAt             DateTime?
  scheduleIntervalHours Int             @default(12)
  productiveRunStreak   Int             @default(0)
  emptyRunStreak        Int             @default(0)
  activeRunId           String?
  runLeaseUntil         DateTime?
  manualRefreshPending  Boolean         @default(false)
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                 DiscoveryItem[]
  runs                  DiscoveryRun[]

  @@index([userId, deletedAt, createdAt])
  @@index([userId, createdAt])
  @@index([nextRunAt, runStatus])
  @@index([pausedAt, nextRunAt])
  @@index([runStatus, runLeaseUntil])
}

model DiscoveryItem {
  id                  String         @id @default(uuid())
  topicId             String
  kind                DiscoveryKind
  title               String
  summary             String
  reason              String
  sourceUrls          String[]
  canonicalPrimaryUrl String
  publishedAt         DateTime?
  discoveredAt        DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sourceType          SourceType     @default(web)
  platform            String         @default("Web")
  authorName          String?
  authorHandle        String?
  externalId          String?
  provenanceKind      ProvenanceKind @default(ai_citation)
  topicKeyword        String
  topic               Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, canonicalPrimaryUrl])
  @@index([topicId, publishedAt, discoveredAt])
}

model DiscoveryRun {
  id               String           @id @default(uuid())
  topicId          String
  trigger          DiscoveryTrigger
  status           RunStatus        @default(queued)
  startedAt        DateTime         @default(now())
  finishedAt       DateTime?
  connectorSummary Json?
  candidateCount   Int              @default(0)
  acceptedCount    Int              @default(0)
  newItemCount     Int              @default(0)
  error            Json?
  keywordSnapshot  String
  expandedTermsSnapshot String[]        @default([])
  keywordProfileSnapshot KeywordProfileKind @default(unknown)
  topic            Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, startedAt])
  @@index([status, startedAt])
}

model TrendMonitor {
  id                   String    @id @default(uuid())
  userId               String    @unique
  runStatus            RunStatus @default(queued)
  nextRunAt            DateTime  @default(now())
  intervalHours        Int       @default(4)
  activeRunId          String?
  runLeaseUntil        DateTime?
  manualRefreshPending Boolean   @default(false)
  lastError            Json?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs                 TrendRun[]

  @@index([nextRunAt, runStatus])
  @@index([runStatus, runLeaseUntil])
  @@unique([id, userId])
}

model TrendRun {
  id             String           @id @default(uuid())
  userId         String
  monitorId      String
  trigger        DiscoveryTrigger
  status         RunStatus        @default(queued)
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?
  candidateCount Int              @default(0)
  acceptedCount  Int              @default(0)
  newItemCount   Int              @default(0)
  error          Json?
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitor        TrendMonitor     @relation(fields: [monitorId, userId], references: [id, userId], onDelete: Cascade)
  seeds          TrendSeed[]
  radarItems     RadarItem[]

  @@index([userId, status, startedAt])
  @@index([monitorId, startedAt])
  @@unique([id, userId])
}

model TrendSeed {
  id              String   @id @default(uuid())
  userId          String
  runId           String
  sourceId        String
  platform        String
  externalId      String?
  title           String
  sourceUrl       String
  fingerprint     String
  publishedAt     DateTime?
  discoveredAt    DateTime @default(now())
  normalizedQuery String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  run             TrendRun @relation(fields: [runId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId, fingerprint, discoveredAt])
  @@index([runId, discoveredAt])
  @@unique([runId, fingerprint])
}

model RadarItem {
  id                  String         @id @default(uuid())
  userId              String
  runId               String
  kind                DiscoveryKind
  title               String
  summary             String
  reason              String
  sourceUrls          String[]
  canonicalPrimaryUrl String
  publishedAt         DateTime?
  discoveredAt        DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  sourceType          SourceType     @default(web)
  platform            String         @default("Web")
  authorName          String?
  authorHandle        String?
  externalId          String?
  provenanceKind      ProvenanceKind @default(ai_citation)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  run                 TrendRun       @relation(fields: [runId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([userId, canonicalPrimaryUrl])
  @@index([userId, publishedAt, discoveredAt])
  @@index([runId, discoveredAt])
}

model CreatorSubscription {
  id              String          @id @default(uuid())
  userId          String
  platform        CreatorPlatform
  accountKey      String
  displayName     String
  profileUrl      String
  feedUrl         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  pausedAt        DateTime?
  cancelledAt     DateTime?
  runStatus       RunStatus       @default(queued)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  activeRunId     String?
  runLeaseUntil   DateTime?
  lastError       Json?
  degradedSources Json?
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs            CreatorRun[]
  items           CreatorItem[]

  @@unique([userId, platform, accountKey])
  @@index([userId, pausedAt, nextRunAt])
  @@index([runStatus, runLeaseUntil])
}

model CreatorRun {
  id              String              @id @default(uuid())
  userId          String
  creatorId       String
  trigger         DiscoveryTrigger
  status          RunStatus           @default(queued)
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  candidateCount  Int                 @default(0)
  acceptedCount   Int                 @default(0)
  newItemCount    Int                 @default(0)
  error           Json?
  degradedSources Json?
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator         CreatorSubscription @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([userId, status, startedAt])
  @@index([creatorId, startedAt])
  @@unique([id, userId])
}

model CreatorItem {
  id                  String              @id @default(uuid())
  userId              String
  creatorId           String
  kind                DiscoveryKind
  title               String
  summary             String
  reason              String
  sourceUrls          String[]
  canonicalPrimaryUrl String
  publishedAt         DateTime?
  discoveredAt        DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  sourceType          SourceType          @default(feed)
  platform            String              @default("RSS/Atom")
  authorName          String?
  authorHandle        String?
  externalId          String?
  provenanceKind      ProvenanceKind      @default(feed_entry)
  feedEligible        Boolean             @default(true)
  contentType         CreatorContentType  @default(original)
  originalAuthorName  String?
  originalAuthorHandle String?
  originalContentId   String?
  originalContentUrl  String?
  parentContentId     String?
  parentContentUrl    String?
  parentContentText   String?
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator             CreatorSubscription @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, canonicalPrimaryUrl])
  @@index([userId, publishedAt, discoveredAt])
  @@index([creatorId, publishedAt, discoveredAt])
}

model ContentFeedback {
  id         String        @id @default(uuid())
  userId     String
  contentKey String
  value      FeedbackValue
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentKey])
  @@index([userId, updatedAt])
}

model InterestTag {
  id              String            @id @default(uuid())
  slug            String
  displayName     String
  parentId        String?
  kind            InterestTagKind
  status          InterestTagStatus @default(active)
  taxonomyVersion String
  createdAt       DateTime          @default(now())
  parent          InterestTag?      @relation("InterestTagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        InterestTag[]     @relation("InterestTagHierarchy")
  contentTags     ContentInterestTag[]
  adjacentLeft    InterestTagAdjacency[] @relation("InterestTagAdjacencyLeft")
  adjacentRight   InterestTagAdjacency[] @relation("InterestTagAdjacencyRight")
  userProfiles    UserInterestProfile[]
  forgottenBy     ForgottenInterestTag[]

  @@unique([slug, taxonomyVersion])
  @@index([parentId])
  @@index([taxonomyVersion, status])
}

model ContentInterestTag {
  contentKey       String
  tagId            String
  confidence       Float
  extractorVersion String
  createdAt        DateTime    @default(now())
  tag              InterestTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentKey, tagId, extractorVersion])
  @@index([contentKey, extractorVersion])
  @@index([tagId, createdAt])
}

model InterestTagAdjacency {
  leftTagId       String
  rightTagId      String
  relationVersion String
  createdAt       DateTime    @default(now())
  leftTag         InterestTag @relation("InterestTagAdjacencyLeft", fields: [leftTagId], references: [id], onDelete: Cascade)
  rightTag        InterestTag @relation("InterestTagAdjacencyRight", fields: [rightTagId], references: [id], onDelete: Cascade)

  @@id([leftTagId, rightTagId, relationVersion])
  @@index([leftTagId, relationVersion])
  @@index([rightTagId, relationVersion])
}

model InterestEvent {
  id           String            @id @default(uuid())
  userId       String
  eventType    InterestEventType
  sourceRef    String
  activeKey    String?
  payload      Json
  occurredAt   DateTime
  recordedAt   DateTime          @default(now())
  supersededAt DateTime?
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventType, activeKey])
  @@index([userId, occurredAt])
  @@index([userId, eventType, sourceRef, occurredAt])
}

model UserInterestProfile {
  userId            String
  tagId             String
  shortScore        Float
  longScore         Float
  negativeScore     Float
  evidenceUpdatedAt DateTime
  computedAt        DateTime
  profileVersion    String
  sourceKinds       String[]                 @default([])
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag               InterestTag            @relation(fields: [tagId], references: [id], onDelete: Cascade)
  version            InterestProfileVersion @relation(fields: [userId, profileVersion], references: [userId, version], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([userId, shortScore])
  @@index([userId, longScore])
  @@index([userId, negativeScore])
}

model InterestProfileVersion {
  userId         String
  version        String
  throughEventId String?
  computedAt     DateTime
  policyVersion  String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profiles       UserInterestProfile[]
  decisions      RecommendationDecision[]

  @@id([userId, version])
  @@index([userId, computedAt])
}

model RecommendationDecision {
  id               String                    @id @default(uuid())
  userId           String
  surface          RecommendationSurface
  requestKey       String
  profileVersion   String
  rankingVersion   String
  candidateVersion String
  asOf             DateTime
  createdAt        DateTime                  @default(now())
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile          InterestProfileVersion    @relation(fields: [userId, profileVersion], references: [userId, version], onDelete: Cascade)
  items            RecommendationDecisionItem[]
  impressions      FeedImpression[]

  @@unique([userId, surface, requestKey])
  @@index([userId, createdAt])
  @@index([userId, profileVersion])
}

model FeedImpression {
  id         String                @id @default(uuid())
  userId     String
  decisionId String
  contentKey String
  position   Int
  surface    RecommendationSurface @default(feed)
  bucketStart DateTime
  shownAt    DateTime              @default(now())
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision   RecommendationDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@unique([userId, decisionId, contentKey, bucketStart])
  @@index([userId, surface, shownAt])
  @@index([contentKey, shownAt])
}

model RecommendationDecisionItem {
  decisionId   String
  contentKey   String
  position     Int
  lane         RecommendationLane
  isExploration Boolean
  reasonCodes  String[]
  decision     RecommendationDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@id([decisionId, contentKey])
  @@unique([decisionId, position])
  @@index([contentKey])
}

model InterestMemorySettings {
  userId                 String   @id
  personalizationEnabled Boolean  @default(true)
  resetAt                DateTime?
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ForgottenInterestTag {
  userId    String
  tagId     String
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       InterestTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
  @@index([userId, createdAt])
}

model DigestPreference {
  userId              String   @id
  enabled             Boolean  @default(false)
  localSendTime       String   @default("08:00")
  recipientEmail      String?
  recipientStatus     String   @default("unverified")
  recipientVerifiedAt DateTime?
  recipientSuppressionReason String?
  recipientSuppressedAt DateTime?
  unsubscribeTokenId  String   @unique @default(uuid())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DigestEmailVerification {
  id        String    @id @default(uuid())
  userId    String
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  providerMessageId String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([providerMessageId])
}

model DigestTestEmail {
  id                String   @id @default(uuid())
  userId            String
  recipientEmail    String
  idempotencyBucket String
  status            String   @default("queued")
  providerMessageId String?
  errorCode         String?
  attemptCount      Int      @default(0)
  runLeaseUntil     DateTime?
  createdAt         DateTime @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyBucket])
  @@index([userId, createdAt])
  @@index([status, runLeaseUntil])
  @@index([providerMessageId])
}

model DigestRun {
  id                 String          @id @default(uuid())
  userId             String
  recipientEmail     String?
  unsubscribeTokenId String?
  scheduledLocalDate String
  windowStart        DateTime
  windowEnd          DateTime
  status             DigestRunStatus @default(queued)
  createdAt          DateTime        @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  sentAt             DateTime?
  providerMessageId  String?
  error              Json?
  runLeaseUntil      DateTime?
  attemptCount       Int             @default(0)
  briefGenerationStatus    String    @default("fallback")
  briefGenerationVersion   String    @default("digest-brief-fallback-v1")
  briefGenerationErrorCode String?
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items              DigestItem[]

  @@unique([userId, scheduledLocalDate])
  @@index([status, runLeaseUntil])
  @@index([userId, windowEnd])
  @@index([providerMessageId])
}

model EmailDeliveryEvent {
  id                String   @id @default(uuid())
  provider          String
  providerEventId   String
  eventType         String
  outcome           String
  providerMessageId String
  occurredAt        DateTime
  createdAt         DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([providerMessageId])
  @@index([createdAt])
}

model DigestItem {
  runId        String
  contentKey   String
  position     Int
  title        String
  summary      String
  reason       String
  sourceUrl    String
  citationUrls String[] @default([])
  platform     String   @default("Web")
  publishedAt  DateTime?
  evidence     String   @default("")
  uncertainty  String   @default("")
  followUp     String   @default("")
  run           DigestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, contentKey])
  @@unique([runId, position])
  @@index([contentKey])
}
