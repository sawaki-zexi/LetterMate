POSTGRES_PASSWORD=replace-with-a-long-random-password
# For Docker Compose use host db and URL-encode reserved password characters.
DATABASE_URL=postgresql+psycopg://lettermate:replace-with-a-url-encoded-password@db:5432/lettermate
APP_ENV=production
LOG_LEVEL=INFO

LLM_PROVIDER=fake
LLM_MODEL=fake-local
OPENAI_API_KEY=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=lettermate@example.com
SMTP_TO=you@example.com
SMTP_USE_TLS=false
EMAIL_DRY_RUN=true

FEEDBACK_SIGNING_SECRET=replace-with-a-32-character-minimum-random-secret
OWNER_API_TOKEN=replace-with-a-32-character-minimum-random-owner-token
SCHEDULER_TOKEN=replace-with-a-32-character-minimum-random-scheduler-token
FEEDBACK_BASE_URL=http://localhost:8000/feedback
FEEDBACK_TOKEN_TTL_HOURS=168
FEEDBACK_USEFUL_WEIGHT=1
FEEDBACK_SAVED_WEIGHT=2
FEEDBACK_NOT_INTERESTED_WEIGHT=-2
