NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://lettermate:lettermate@localhost:5432/lettermate
REDIS_URL=redis://localhost:6379
METRICS_PORT=9464
# Production Compose only. Use generated secrets and service-host URLs above.
POSTGRES_DB=lettermate
POSTGRES_USER=lettermate
POSTGRES_PASSWORD=
REDIS_PASSWORD=
BACKUP_DIRECTORY=.backups/postgres
SESSION_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-at-least-32-random-characters
ALLOW_DEV_IDENTITY=true
AI_API_KEY=
AI_MODEL=openrouter/auto
AI_FAST_MODEL=
AI_QUALITY_MODEL=
AI_LOCALIZATION_MODEL=
AI_FALLBACK_MODELS=
AI_PROVIDER_ORDER=DeepSeek
AI_PROVIDER_FALLBACKS=false
AI_RESERVED_COST_USD_PER_CALL=0.05
AI_RUN_MAX_CALLS=200
AI_RUN_MAX_INPUT_TOKENS=2000000
AI_RUN_MAX_OUTPUT_TOKENS=1000000
AI_RUN_MAX_COST_USD=10
AI_WEB_SEARCH=true
AI_TIMEOUT_MS=60000

TWITTERAPI_IO_API_KEY=
GITHUB_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SEARCH_PROVIDER=
SEARCH_API_KEY=
SEARCH_API_BASE_URL=
TAVILY_API_KEY=
TAVILY_API_BASE_URL=
BING_SEARCH_ENABLED=true
BING_SEARCH_BASE_URL=https://cn.bing.com/search
DISCOVERY_RSS_FEED_URLS=

DISCOVERY_RUN_TIMEOUT_MS=600000
DISCOVERY_CONNECTOR_CONCURRENCY=4
DISCOVERY_SCHEDULER_ENABLED=true

TREND_MONITOR_ENABLED=true
TREND_INTERVAL_HOURS=4
TREND_X_WOEIDS=1
TREND_YOUTUBE_REGION=US
TREND_REDDIT_COMMUNITIES=MachineLearning,LocalLLaMA,programming,technology
TREND_GOOGLE_RSS_URLS=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_MESSAGE_ID_DOMAIN=lettermate.local
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000

RUN_LIVE_AI_TESTS=0
RUN_LIVE_TWITTERAPI_IO_TESTS=0
RUN_LIVE_BILIBILI_TESTS=0
BILIBILI_LIVE_MID=
RUN_LIVE_EMAIL_TESTS=0
SMTP_SMOKE_RECIPIENT=
